# Copia este archivo a .env y ajusta los valores.
# .env NUNCA debe subirse al repositorio (ya esta en .gitignore).

# --- Base de datos ---
POSTGRES_DB=sgii
POSTGRES_USER=sgii_app
POSTGRES_PASSWORD=cambiame_en_local

# --- Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker
# validate = falla si el esquema no coincide (recomendado con migraciones)
# update   = Hibernate ajusta el esquema (comodo en desarrollo, peligroso en prod)
DDL_AUTO=validate
JWT_SECRET=genera_una_cadena_larga_y_aleatoria_de_al_menos_32_caracteres

# --- Frontend ---
FRONTEND_PORT=4200

# --- Build ---
JAVA_VERSION=21
NODE_VERSION=20
TAG=latest
DOCKERHUB_USERNAME=tu-usuario-dockerhub
